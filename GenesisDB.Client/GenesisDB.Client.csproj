<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>GenesisDB.Client</PackageId>
    <Version>2.0.0</Version>
    <Authors>Patric Eckhart</Authors>
    <Company>GenesisDB</Company>
    <Description>The official .NET client for GenesisDB, the open source event sourcing database.</Description>
    <PackageTags>genesisdb;event-sourcing;event-store;cloudevents;cqrs;database;client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.genesisdb.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/genesisdb-io/genesisdb-io-client-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
